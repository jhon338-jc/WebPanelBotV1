# Dependencies
node_modules/
bots/node_modules/
bots/*/node_modules
bots/*/package-lock.json
bots/package-lock.json

# Env & secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*

# Bot auth/session (paksa pairing ulang setelah clone)
bots/*/auth/

# Bot hasil generate setup.sh (Bot11..Bot50) - tidak di-commit
bots/Bot1[1-9]/
bots/Bot[2-4][0-9]/
bots/Bot50/

# Bot database/session state
bots/*/database/
bots/*/session/
bots/*/tmp/

# Data runtime panel (buatan server saat jalan) - jangan di-commit
database/sewa.json
database/sellers.json
database/payment-qr.png

# Plugin hasil sync-duplikasi di Bot2..Bot10 (source of truth = Bot1/plugins).
# File tracked lama tetap ke-track, hanya file duplikat baru yang di-ignore.
bots/Bot2/plugins/*
bots/Bot3/plugins/*
bots/Bot4/plugins/*
bots/Bot5/plugins/*
bots/Bot6/plugins/*
bots/Bot7/plugins/*
bots/Bot8/plugins/*
bots/Bot9/plugins/*
bots/Bot10/plugins/*

# OS
.DS_Store

# Termux/editor
termux/.fix

# Landing page (punya repo GitHub sendiri: Panel-Web-Bot)
landing-page/
