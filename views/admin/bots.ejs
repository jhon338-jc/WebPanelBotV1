<% content = `
<div class="space-y-6">
    <div class="flex justify-between items-center">
        <h3 class="text-lg font-semibold text-gray-800">
            <i class="fas fa-robot mr-2 text-blue-600"></i> Manage Bots
        </h3>
        <div class="flex items-center space-x-3">
            <span class="text-xs px-2 py-1 rounded-full bg-blue-100 text-blue-600">
                <i class="fas fa-sync mr-1"></i> Auto-refresh 5s
            </span>
            <a href="/admin/bots" class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
                <i class="fas fa-sync mr-2"></i> Refresh
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 items-start">
        ${bots.map(bot => {
            const logs = (initialLogs && initialLogs[bot.folder]) || []
            return `
            <div class="space-y-3">
                <div class="card bg-white rounded-xl p-6 shadow-sm" id="bot-card-${bot.folder}">
                    <div class="flex items-center justify-between mb-4">
                        <h4 class="font-semibold text-gray-800">${bot.folder}</h4>
                        <span class="px-2 py-1 text-xs rounded-full ${bot.realtimeStatus === 'running' ? 'bg-yellow-100 text-yellow-600' : bot.connected ? 'bg-green-100 text-green-600' : 'bg-gray-100 text-gray-600'}">
                            ${bot.realtimeStatus === 'running' ? 'Starting' : bot.connected ? 'Connected' : 'Stopped'}
                        </span>
                    </div>
                    <div class="space-y-2 text-sm text-gray-600">
                        <p><i class="fas fa-user mr-2"></i> ${bot.assigned_username || 'Tidak di-assign'}</p>
                        <p><i class="fas fa-clock mr-2"></i> ${bot.last_active ? new Date(bot.last_active).toLocaleString('id-ID') : '-'}</p>
                        ${bot.pairingCode ? `
                            <div class="mt-2 p-3 bg-orange-50 border-2 border-orange-300 rounded-lg">
                                <p class="text-xs text-orange-600 font-semibold"><i class="fas fa-link mr-1"></i> KODE PAIRING</p>
                                <p class="text-2xl font-mono font-bold text-orange-700 tracking-widest select-all">${bot.pairingCode}</p>
                                <p class="text-xs text-orange-500 mt-1">Buka WhatsApp → Perangkat Tertaut → Pairing</p>
                            </div>
                        ` : ''}
                        ${bot.waitingInput ? `
                            <div class="mt-3 p-3 bg-indigo-50 border-2 border-indigo-300 rounded-lg">
                                <p class="text-xs text-indigo-600 font-semibold mb-2"><i class="fas fa-keyboard mr-1"></i> Bot meminta input</p>
                                <form class="input-form flex space-x-2" data-folder="${bot.folder}">
                                    <input type="text" name="input" placeholder="Masukkan nomor (contoh: 628xxx)" class="input-input flex-1 px-3 py-2 border border-indigo-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400" autocomplete="off" />
                                    <button class="px-3 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm">Kirim</button>
                                </form>
                            </div>
                        ` : ''}
                    </div>
                    <div class="mt-4 flex space-x-2">
                        <a href="/api/admin/bots/${bot.folder}/start?redirect=/admin/bots" class="flex-1 px-3 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 text-sm text-center">
                            <i class="fas fa-play mr-1"></i> Start
                        </a>
                        <a href="/api/admin/bots/${bot.folder}/stop?redirect=/admin/bots" class="flex-1 px-3 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 text-sm text-center">
                            <i class="fas fa-stop mr-1"></i> Stop
                        </a>
                        <a href="/api/admin/bots/${bot.folder}/restart?redirect=/admin/bots" class="flex-1 px-3 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 text-sm text-center">
                            <i class="fas fa-sync mr-1"></i> Restart
                        </a>
                    </div>
                    <div class="mt-2">
                        <button onclick="confirmLogout('${bot.folder}')" class="w-full px-3 py-2 bg-gray-800 text-white rounded-lg hover:bg-red-700 text-sm text-center border border-gray-300">
                            <i class="fas fa-sign-out-alt mr-1"></i> Logout (hapus dari perangkat)
                        </button>
                    </div>
                </div>
                <div class="bg-gray-900 rounded-xl shadow-sm overflow-hidden">
                    <div class="flex items-center justify-between px-4 py-2 bg-gray-800 border-b border-gray-700">
                        <span class="text-xs font-semibold text-gray-300"><i class="fas fa-terminal mr-1"></i> Log ${bot.folder}</span>
                    </div>
                    <div class="log-container p-4 h-56 overflow-y-auto" data-folder="${bot.folder}">
                        ${logs.length > 0 ? logs.map(l =>
                            `<div class="${l.level === 'error' ? 'log-error' : l.level === 'warn' ? 'log-warn' : 'log-info'}">[${new Date(l.timestamp).toLocaleTimeString('id-ID')}] ${l.message}</div>`
                        ).join('') : '<p class="log-info">Belum ada log</p>'}
                    </div>
                </div>
            </div>
            `
        }).join('')}
    </div>
</div>
` %>

<%- include('../layouts/main', { title: 'Manage Bots', content: content }) %>

<script>
    // Pertahankan posisi scroll saat halaman auto-refresh
    window.addEventListener('beforeunload', () => {
        sessionStorage.setItem('botsScroll', document.documentElement.scrollTop || window.scrollY)
    })
    document.addEventListener('DOMContentLoaded', () => {
        const top = sessionStorage.getItem('botsScroll')
        if (top) {
            window.scrollTo(0, parseInt(top, 10))
            sessionStorage.removeItem('botsScroll')
        }
    })

    // Kirim input interaktif ke bot via API (tanpa reload)
    document.addEventListener('submit', async (e) => {
        const form = e.target.closest('.input-form')
        if (!form) return
        e.preventDefault()
        const folder = form.dataset.folder
        const inputValue = form.querySelector('.input-input').value.trim()
        if (!inputValue) {
            alert('Mohon isi input terlebih dahulu')
            return
        }
        form.querySelector('button').disabled = true
        try {
            const res = await fetch(`/api/admin/bots/${folder}/input`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ input: inputValue })
            })
            const data = await res.json()
            if (data.success) {
                form.innerHTML = '<p class="text-xs text-green-600 font-semibold"><i class="fas fa-check mr-1"></i> Input terkirim. Tunggu kode pairing...</p>'
            } else {
                alert(data.message || 'Gagal kirim input')
                form.querySelector('.input-input').value = ''
            }
        } catch (err) {
            alert('Gagal terhubung ke server')
        } finally {
            form.querySelector('button').disabled = false
        }
    })

    // Auto-refresh halaman setiap 5 detik agar log selalu ter-update
    setTimeout(() => { location.reload() }, 5000)

    // Konfirmasi sebelum logout (hapus auth) bot
    function confirmLogout(folder) {
        if (confirm(`Yakin ingin LOGOUT ${folder}?\n\nBot akan dikeluarkan dari WhatsApp dan harus pairing ulang dari awal.`)) {
            window.location.href = `/api/admin/bots/${folder}/logout?redirect=/admin/bots`
        }
    }
</script>