<% content = `
<div class="space-y">
    <div class="grid-stats">
        <div class="card-brutal stat-card flex-bt">
            <div>
                <p class="stat-label">Total Bots</p>
                <p class="stat-value">${stats.totalBots}</p>
            </div>
            <div class="stat-icon" style="background:#8ecae6"><i class="fas fa-robot"></i></div>
        </div>
        <div class="card-brutal stat-card flex-bt">
            <div>
                <p class="stat-label">Bot Aktif</p>
                <p class="stat-value" style="color:#118ab2">${stats.activeBots}</p>
            </div>
            <div class="stat-icon" style="background:#7bf1a8"><i class="fas fa-check-circle"></i></div>
        </div>
        <div class="card-brutal stat-card flex-bt">
            <div>
                <p class="stat-label">Bot Running</p>
                <p class="stat-value" style="color:#b388eb">${stats.runningBots}</p>
            </div>
            <div class="stat-icon" style="background:#b388eb"><i class="fas fa-play-circle"></i></div>
        </div>
        <div class="card-brutal stat-card flex-bt">
            <div>
                <p class="stat-label">Total Users</p>
                <p class="stat-value" style="color:#ef8354">${stats.totalUsers}</p>
            </div>
            <div class="stat-icon" style="background:#ffb703"><i class="fas fa-users"></i></div>
        </div>
    </div>

    <div class="card-brutal">
        <h3 class="card-title"><i class="fas fa-server"></i> System Information</h3>
        <div class="grid-bots">
            <div class="bot-mini">
                <p class="muted">Node Version</p>
                <p style="font-weight:700;margin-top:4px">${systemInfo.nodeVersion}</p>
            </div>
            <div class="bot-mini">
                <p class="muted">Platform</p>
                <p style="font-weight:700;margin-top:4px">${systemInfo.platform} (${systemInfo.arch})</p>
            </div>
            <div class="bot-mini">
                <p class="muted">CPU / RAM</p>
                <p style="font-weight:700;margin-top:4px">${systemInfo.cpuCount} core / ${systemInfo.processMemory} MB</p>
            </div>
            <div class="bot-mini">
                <p class="muted">Uptime</p>
                <p style="font-weight:700;margin-top:4px">${Math.floor(systemInfo.uptime / 60)} menit</p>
            </div>
        </div>
    </div>

    <div class="card-brutal">
        <div class="flex-bt mb-16">
            <h3 class="card-title" style="margin-bottom:0"><i class="fas fa-robot"></i> Bot Status Overview</h3>
            <a href="/admin/bots" class="btn-brutal btn-brutal-sm btn-blue"><i class="fas fa-cog"></i> Manage</a>
        </div>
        <div class="grid-bots" style="grid-template-columns:repeat(auto-fill,minmax(180px,1fr))">
            ${bots.map(bot => {
                const statusColor = bot.connected ? 'badge-green' :
                                    bot.realtimeStatus === 'running' ? 'badge-yellow' :
                                    'badge-gray'
                const statusText = bot.connected ? 'Connected' :
                                   bot.realtimeStatus === 'running' ? 'Running' : 'Stopped'
                return `
                    <div class="bot-mini">
                        <p class="bot-name">${bot.folder}</p>
                        <span class="badge ${statusColor}" style="margin-top:8px">${statusText}</span>
                        ${bot.assigned_username ? '<p class="muted mt-8">' + bot.assigned_username + '</p>' : ''}
                    </div>
                `
            }).join('')}
        </div>
    </div>
</div>
` %>

<%- include('../layouts/main', { title: 'Admin Dashboard', content: content }) %>

<script>
    setInterval(() => { window.location.reload() }, 10000)
</script>
