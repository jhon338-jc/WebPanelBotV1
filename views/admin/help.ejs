      ['.iqc', 'Cek IQ'],
      ['.fakedana Jumlah', 'Fake dana'],
      ['.fakeff Nama', 'Fake FF'],
      ['.detik', 'Berita detik'],
      ['.rvo', 'Read view once']
    ]
  }
]

content = `
<div class="space-y">
    <div class="flex-bt">
        <h2 class="title-stroke" style="font-size:26px"><i class="fas fa-book open"></i> Panduan Fitur Bot</h2>
        <a href="/admin/bots" class="btn-brutal btn-brutal-sm btn-blue"><i class="fas fa-robot"></i> Manage Bots</a>
    </div>
    <div class="card-brutal">
        <h3 class="card-title"><i class="fas fa-info-circle"></i> Cara Pakai Bot</h3>
        <ol style="line-height:2;padding-left:20px" class="muted" style="font-size:14px">
            <li>Start bot dari halaman <b>Bots</b>.</li>
            <li>Bot minta nomor → input nomor HP di web (tanpa +, contoh <b>628xxx</b>).</li>
            <li>Pairing code muncul → buka WhatsApp &rarr; <b>Perangkat Tertaut &rarr; Tautkan</b> &rarr; masukin kode.</li>
            <li>Status jadi <b>Connected</b> &rarr; bot siap dipakai.</li>
            <li>Kirim perintah di DM/grup, contoh <b>.ping</b> atau <b>.menu</b>.</li>
        </ol>
        <p class="muted mt-16">Semua bot sudah punya plugin <b>jimp</b> (stiker/gambar) dan database lengkap &mdash; tanpa error.</p>
    </div>
    ${sections.map(s => `
    <div class="card-brutal">
        <h3 class="card-title"><i class="fas fa-${s.icon}"></i> ${s.title}</h3>
        <div class="table-wrap">
            <table class="b-brutal">
                <thead><tr><th style="width:220px">Perintah</th><th>Fungsi</th></tr></thead>
                <tbody>
                ${s.commands.map(c => `<tr><td><code style="background:#eceade;padding:2px 8px;font-weight:700">${c[0]}</code></td><td>${c[1]}</td></tr>`).join('')}
                </tbody>
            </table>
        </div>
    </div>`).join('')}
</div>
`
