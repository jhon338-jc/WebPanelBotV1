      ['.toimg', 'Stiker ke gambar'],
      ['.tt URL', 'Download TikTok'],
      ['.ig URL', 'Download Instagram'],
      ['.fb URL', 'Download Facebook'],
      ['.mp3 URL', 'Download YouTube audio'],
