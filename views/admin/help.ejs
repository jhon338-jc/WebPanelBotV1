<%
const sections = [
  {
    icon: 'users', title: 'GROUP COMMANDS',
    commands: [
      ['.sg', 'Pilih grup yang dipantau'],
      ['.grouplist', 'Lihat semua grup'],
      ['.kick @user', 'Kick member'],
      ['.add 628xx', 'Tambah member'],
      ['.addadmin @user', 'Jadikan admin'],
      ['.deladmin @user', 'Hapus admin'],
      ['.setname Nama', 'Ganti nama grup'],
      ['.setdesc Teks', 'Ganti deskripsi grup'],
      ['.totag', 'Tag semua member'],
      ['.hidetag', 'Tag semua member (sembunyi)']
    ]
  },
  {
    icon: 'crown', title: 'OWNER COMMANDS',
    commands: [
      ['.addowner 628xx', 'Tambah owner'],
      ['.delowner 628xx', 'Hapus owner'],
      ['.public', 'Mode public'],
      ['.self', 'Mode self'],
      ['.setbio Teks', 'Ganti bio bot'],
      ['.setnamebot Nama', 'Ganti nama bot'],
      ['.setpp', 'Ganti foto profil bot'],
      ['.leave', 'Keluar grup']
    ]
  },
  {
    icon: 'wrench', title: 'TOOLS COMMANDS',
