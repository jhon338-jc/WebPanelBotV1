<% content = `
<div class="space-y">
    <div class="flex-bt">
        <h3 class="card-title" style="font-size:20px;margin-bottom:0"><i class="fas fa-users"></i> Manage Users</h3>
        <div class="row">
            <a href="/admin/users" class="btn-brutal btn-brutal-sm btn-blue"><i class="fas fa-sync"></i> Refresh</a>
            <button onclick="showAddUserModal()" class="btn-brutal btn-brutal-sm btn-green">
                <i class="fas fa-plus"></i> Tambah User
            </button>
        </div>
    </div>

    <div class="table-wrap">
        <table class="b-brutal">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Password</th>
                    <th>Level</th>
                    <th>Status</th>
                    <th>Bot Quota</th>
                    <th>Password Req</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                ${users.length === 0 ? `
                    <tr><td colspan="9" class="muted" style="text-align:center">Tidak ada user</td></tr>
                ` : users.map(user => `
                    <tr>
                        <td>${user.id}</td>
                        <td><strong>${user.username}</strong></td>
                        <td>${user.email || '<span class="muted">-</span>'}</td>
                        <td>
                            <div class="row" style="gap:6px;flex-wrap:nowrap">
                                <span class="pass-view" id="pass-${user.id}">${user.password_plain || '&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;'}</span>
                                <button onclick="togglePass(${user.id}, this)" class="btn-brutal btn-brutal-sm btn-blue" style="padding:3px 8px;font-size:10px" title="Lihat password">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </td>
                        <td>
                            <span class="badge ${user.level === 'admin' ? 'badge-red' : user.level === 'premium' ? 'badge-purple' : user.level === 'langganan' ? 'badge-blue' : 'badge-green'}">${user.level}</span>
                        </td>
                        <td>
                            <span class="badge ${user.status === 'active' ? 'badge-green' : 'badge-red'}">${user.status}</span>
                        </td>
                        <td>
                            <strong>${user.bot_quota}</strong>
                            <button onclick="addQuotaModal(${user.id}, '${user.username}')" class="btn-brutal btn-brutal-sm btn-yellow" style="padding:3px 8px;font-size:10px" title="Tambah quota">
                                <i class="fas fa-plus"></i>
                            </button>
                        </td>
                        <td>
                            ${user.pending_password ? `
                                <div class="row" style="gap:6px;flex-wrap:nowrap">
                                    <span class="badge badge-yellow" style="white-space:nowrap"><i class="fas fa-key"></i> Request</span>
                                    <button onclick="approvePass(${user.id}, '${user.username}')" class="btn-brutal btn-brutal-sm btn-green" style="padding:3px 8px;font-size:10px"><i class="fas fa-check"></i></button>
                                    <button onclick="rejectPass(${user.id})" class="btn-brutal btn-brutal-sm btn-red" style="padding:3px 8px;font-size:10px"><i class="fas fa-times"></i></button>
                                </div>
                            ` : '<span class="muted">-</span>'}
                        </td>
                        <td>
                            <div class="row" style="gap:6px">
                                <button onclick="showEditUserModal(${user.id}, '${user.username}', '${user.level}', ${user.bot_quota}, '${user.status}')" class="btn-brutal btn-brutal-sm btn-blue">
                                    Edit
                                </button>
                                <button onclick="toggleUserStatus(${user.id}, '${user.username}', '${user.status}')" class="btn-brutal btn-brutal-sm ${user.status === 'active' ? 'btn-red' : 'btn-green'}">
                                    ${user.status === 'active' ? 'Ban' : 'Unban'}
                                </button>
                                <button onclick="deleteUser(${user.id}, '${user.username}')" class="btn-brutal btn-brutal-sm btn-dark">
                                    Delete
                                </button>
                            </div>
                        </td>
                    </tr>
                `).join('')}
            </tbody>
        </table>
    </div>
</div>

<div id="add-user-modal" class="modal">
    <div class="modal-card">
        <h4 style="font-family:'Archivo Black',monospace;text-transform:uppercase" class="mb-16"><i class="fas fa-user-plus"></i> Tambah User</h4>
        <form id="add-user-form" class="space-y">
            <div class="field">
                <label>Username</label>
                <div class="input-wrap">
                    <i class="fas fa-user"></i>
                    <input type="text" name="username" placeholder="Username" required class="input-brutal">
                </div>
            </div>
            <div class="field">
                <label>Password</label>
                <div class="input-wrap">
                    <i class="fas fa-lock"></i>
                    <input type="text" name="password" placeholder="Password" required class="input-brutal">
                </div>
            </div>
            <div class="field">
                <label>Email (opsional)</label>
                <div class="input-wrap">
                    <i class="fas fa-envelope"></i>
                    <input type="email" name="email" placeholder="Email (opsional)" class="input-brutal">
                </div>
            </div>
            <div class="field">
                <label>Level</label>
                <div class="input-wrap">
                    <i class="fas fa-user-tag"></i>
                    <select name="level" class="input-brutal">
                        <option value="admin">Admin</option>
                        <option value="premium">Premium</option>
                        <option value="langganan">Langganan</option>
                        <option value="member">Member</option>
                    </select>
                </div>
            </div>
            <div class="field">
                <label>Bot Quota</label>
                <div class="input-wrap">
                    <i class="fas fa-layer-group"></i>
                    <input type="number" name="bot_quota" value="1" min="0" required class="input-brutal">
                </div>
            </div>
            <div class="row">
                <button type="submit" class="btn-brutal btn-green" style="flex:1"><i class="fas fa-save"></i> Tambah</button>
                <button type="button" onclick="closeAddUserModal()" class="btn-brutal btn-dark"><i class="fas fa-times"></i> Batal</button>
            </div>
        </form>
    </div>
</div>

<div id="edit-user-modal" class="modal">
    <div class="modal-card">
        <h4 style="font-family:'Archivo Black',monospace;text-transform:uppercase" class="mb-16"><i class="fas fa-user-edit"></i> Edit User</h4>
        <form id="edit-user-form" class="space-y">
            <input type="hidden" name="id">
            <div class="field">
                <label>Username</label>
                <div class="input-wrap">
                    <i class="fas fa-user"></i>
                    <input type="text" name="username" placeholder="Username" required class="input-brutal">
                </div>
            </div>
            <div class="field">
                <label>Password (kosongkan jika tidak diubah)</label>
                <div class="input-wrap has-toggle">
                    <i class="fas fa-lock"></i>
                    <input type="password" name="password" placeholder="Password baru" class="input-brutal" id="edit-password" autocomplete="off">
                    <button type="button" class="toggle-pass" onclick="togglePassword('edit-password', this)">
                        <i class="fas fa-eye"></i>
                    </button>
                </div>
            </div>
            <div class="field">
                <label>Level</label>
                <div class="input-wrap">
                    <i class="fas fa-user-tag"></i>
                    <select name="level" class="input-brutal">
                        <option value="admin">Admin</option>
                        <option value="premium">Premium</option>
                        <option value="langganan">Langganan</option>
                        <option value="member">Member</option>
                    </select>
                </div>
            </div>
            <div class="field">
                <label>Bot Quota</label>
                <div class="input-wrap">
                    <i class="fas fa-layer-group"></i>
                    <input type="number" name="bot_quota" min="0" required class="input-brutal">
                </div>
            </div>
            <div class="row">
                <button type="submit" class="btn-brutal btn-green" style="flex:1"><i class="fas fa-save"></i> Simpan</button>
                <button type="button" onclick="closeEditUserModal()" class="btn-brutal btn-dark"><i class="fas fa-times"></i> Batal</button>
            </div>
        </form>
    </div>
</div>
` %>

<%- include('../layouts/main', { title: 'Manage Users', content: content }) %>

<script>
    function levelClass(level) {
        return level === 'admin' ? 'badge-red'
             : level === 'premium' ? 'badge-purple'
             : level === 'langganan' ? 'badge-blue' : 'badge-green'
    }

    function showAddUserModal() {
        document.getElementById('add-user-modal').classList.add('open')
    }
    function closeAddUserModal() {
        document.getElementById('add-user-modal').classList.remove('open')
    }

    function togglePass(id, btn) {
        const el = document.getElementById('pass-' + id)
        if (el.dataset.reveal) {
            el.innerHTML = el.dataset.orig
            delete el.dataset.reveal
            btn.innerHTML = '<i class="fas fa-eye"></i>'
        } else {
            el.dataset.orig = el.innerHTML
            el.innerHTML = 'Tidak tersedia (hash)'
            el.dataset.reveal = '1'
            btn.innerHTML = '<i class="fas fa-eye-slash"></i>'
        }
    }

    document.getElementById('add-user-form').addEventListener('submit', async (e) => {
        e.preventDefault()
        const formData = new FormData(e.target)
        const data = Object.fromEntries(formData)

        const res = await fetch('/api/admin/users', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        })
        const result = await res.json()
        showToast(result.message, result.success ? 'success' : 'error')

        if (result.success) {
            closeAddUserModal()
            e.target.reset()
            window.location.reload()
        }
    })

    function showEditUserModal(id, username, level, quota, status) {
        const form = document.getElementById('edit-user-form')
        form.querySelector('[name=id]').value = id
        form.querySelector('[name=username]').value = username
        form.querySelector('[name=password]').value = ''
        form.querySelector('[name=level]').value = level
        form.querySelector('[name=bot_quota]').value = quota
        form.dataset.status = status
        document.getElementById('edit-user-modal').classList.add('open')
    }
    function closeEditUserModal() {
        document.getElementById('edit-user-modal').classList.remove('open')
    }

    document.getElementById('edit-user-form').addEventListener('submit', async (e) => {
        e.preventDefault()
        const formData = new FormData(e.target)
        const id = formData.get('id')
        const data = {
            username: formData.get('username'),
            level: formData.get('level'),
            bot_quota: formData.get('bot_quota')
        }
        const pass = formData.get('password')
        if (pass) data.password = pass

        const res = await fetch(`/api/admin/users/${id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        })
        const result = await res.json()
        showToast(result.message, result.success ? 'success' : 'error')
        if (result.success) {
            closeEditUserModal()
            window.location.reload()
        }
    })

    function toggleUserStatus(id, username, currentStatus) {
        if (currentStatus === 'active') {
            brutalConfirm({
                title: 'Ban User',
                message: `Yakin ingin mem-banned user ${username}? User tidak bisa login lagi.`,
                confirmText: 'Ban',
                onConfirm: () => setUserStatus(id, 'banned')
            })
        } else {
            setUserStatus(id, 'active')
        }
    }

    async function setUserStatus(id, newStatus) {
        const res = await fetch(`/api/admin/users/${id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status: newStatus })
        })
        const result = await res.json()
        showToast(result.message, result.success ? 'success' : 'error')
        window.location.reload()
    }

    function deleteUser(id, username) {
        brutalConfirm({
            title: 'Hapus User',
            message: `Yakin ingin menghapus user ${username}? Tindakan ini tidak bisa dibatalkan.`,
            confirmText: 'Hapus',
            onConfirm: async () => {
                const res = await fetch(`/api/admin/users/${id}`, { method: 'DELETE' })
                const result = await res.json()
                showToast(result.message, result.success ? 'success' : 'error')
                window.location.reload()
            }
        })
    }

    function addQuotaModal(id, username) {
        brutalPrompt({
            title: 'Tambah Quota',
            message: `Masukkan jumlah quota yang ditambahkan untuk ${username}:`,
            placeholder: 'contoh: 1, 2, 3',
            submitText: 'Tambah',
            inputType: 'number',
            onSubmit: (val) => {
                const add = parseInt(val)
                if (isNaN(add) || add <= 0) {
                    showToast('Jumlah quota tidak valid!', 'error')
                    return
                }
                fetch(`/api/admin/users/${id}/quota`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ add })
                }).then(r => r.json()).then(result => {
                    showToast(result.message, result.success ? 'success' : 'error')
                    window.location.reload()
                })
            }
        })
    }

    function approvePass(id, username) {
        brutalConfirm({
            title: 'Approve Password',
            message: `Setujui permintaan ganti password ${username}?`,
            confirmText: 'Approve',
            onConfirm: async () => {
                const res = await fetch(`/api/admin/users/${id}/approve-password`, { method: 'POST' })
                const result = await res.json()
                showToast(result.message, result.success ? 'success' : 'error')
                window.location.reload()
            }
        })
    }

    function rejectPass(id) {
        brutalConfirm({
            title: 'Tolak Password',
            message: 'Tolak permintaan ganti password ini? Password tidak akan diubah.',
            confirmText: 'Tolak',
            danger: true,
            onConfirm: async () => {
                const res = await fetch(`/api/admin/users/${id}/reject-password`, { method: 'POST' })
                const result = await res.json()
                showToast(result.message, result.success ? 'success' : 'error')
                window.location.reload()
            }
        })
    }
</script>
