<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - Jhon338 Panel</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        :root {
            --bg-body: #f4f2eb; --color-black: #090909; --accent: #ffb703;
            --border-thick: 4px solid var(--color-black);
            --border-med: 3px solid var(--color-black);
            --shadow-solid: 5px 5px 0px var(--color-black);
            --shadow-hover: 2px 2px 0px var(--color-black);
        }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Space Mono', monospace; }
        body {
            background-color: var(--bg-body);
            color: var(--color-black);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 16px;
        }
        .auth-card {
            background: var(--bg-body);
            border: var(--border-thick);
            box-shadow: 10px 10px 0px var(--color-black);
            width: 100%; max-width: 420px; padding: 32px;
        }
        .auth-logo { font-size: 56px; text-align: center; }
        .auth-title {
            text-align: center;
            font-family: 'Archivo Black', sans-serif;
            font-size: 24px;
            text-transform: uppercase;
            -webkit-text-stroke: 1.5px var(--color-black);
            color: transparent;
            margin: 8px 0 4px;
            line-height: 1.1;
        }
        .auth-sub { text-align: center; font-size: 12px; color: #5b584d; margin-bottom: 24px; }
        .error-alert {
            display: none;
            border: var(--border-med); background: #ff8fa3;
            box-shadow: 3px 3px 0px var(--color-black);
            padding: 10px 12px; font-size: 13px; font-weight: 700; margin-bottom: 16px;
        }
        .error-alert.show { display: block; }
        .auth-form { display: flex; flex-direction: column; gap: 16px; }
        .field { display: flex; flex-direction: column; gap: 6px; }
        .field label { font-size: 11px; text-transform: uppercase; font-weight: 700; }
        .input-wrap { position: relative; }
        .input-wrap i { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); font-size: 14px; }
        .input-brutal {
            width: 100%;
            background: var(--bg-body);
            border: var(--border-med);
            box-shadow: 3px 3px 0px var(--color-black);
            padding: 12px 12px 12px 38px;
            font-size: 14px;
            outline: none;
            color: var(--color-black);
            transition: all 0.12s ease;
        }
        .input-brutal:focus { box-shadow: 2px 2px 0px var(--accent); border-color: var(--accent); }
        .btn-brutal {
            width: 100%;
            background: var(--accent);
            border: var(--border-thick);
            box-shadow: var(--shadow-solid);
            padding: 14px;
            font-family: 'Archivo Black', sans-serif;
            text-transform: uppercase;
            font-size: 15px;
            color: var(--color-black);
            transition: all 0.12s ease;
        }
        .btn-brutal:active { transform: translate(3px,3px); box-shadow: var(--shadow-hover); }
        .auth-footer { text-align: center; margin-top: 20px; font-size: 13px; }
        .auth-footer a {
            font-family: 'Archivo Black', sans-serif; text-transform: uppercase; font-size: 12px;
            text-decoration: underline; text-underline-offset: 3px;
        }
        @media (max-width: 480px) { .auth-card { padding: 24px; box-shadow: 6px 6px 0px var(--color-black); } }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="auth-logo"><i class="fas fa-robot"></i></div>
        <h1 class="auth-title">Daftar Akun</h1>
        <p class="auth-sub">Buat akun untuk menggunakan bot</p>

        <div id="error-alert" class="error-alert"></div>

        <form id="register-form" class="auth-form">
            <div class="field">
                <label>Username</label>
                <div class="input-wrap">
                    <i class="fas fa-user"></i>
                    <input type="text" name="username" required minlength="3" class="input-brutal" placeholder="Minimal 3 karakter">
                </div>
            </div>
            <div class="field">
                <label>Email (Opsional)</label>
                <div class="input-wrap">
                    <i class="fas fa-envelope"></i>
                    <input type="email" name="email" class="input-brutal" placeholder="contoh@email.com">
                </div>
            </div>
            <div class="field">
                <label>Password</label>
                <div class="input-wrap">
                    <i class="fas fa-lock"></i>
                    <input type="password" name="password" required minlength="6" class="input-brutal" placeholder="Minimal 6 karakter">
                </div>
            </div>
            <button type="submit" class="btn-brutal">
                <i class="fas fa-user-plus mr-2"></i> Register
            </button>
        </form>

        <p class="auth-footer">
            Sudah punya akun?
            <a href="/login">Login disini</a>
        </p>
    </div>

    <script>
        document.getElementById('register-form').addEventListener('submit', async (e) => {
            e.preventDefault()
            const formData = new FormData(e.target)
            const data = {
                username: formData.get('username'),
                email: formData.get('email'),
                password: formData.get('password')
            }
            const errorAlert = document.getElementById('error-alert')
            errorAlert.classList.remove('show')
            try {
                const res = await fetch('/api/auth/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                })
                const result = await res.json()
                if (result.success) {
                    window.location.href = '/login?registered=1'
                } else {
                    errorAlert.textContent = result.message
                    errorAlert.classList.add('show')
                }
            } catch (error) {
                errorAlert.textContent = 'Server error!'
                errorAlert.classList.add('show')
            }
        })
    </script>
</body>
</html>
