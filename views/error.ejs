<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error <%= code %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        :root { --bg-body: #f4f2eb; --color-black: #090909; --accent: #ffb703;
            --border-thick: 4px solid var(--color-black);
            --shadow-solid: 5px 5px 0px var(--color-black);
            --shadow-hover: 2px 2px 0px var(--color-black); }
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Space Mono', monospace; }
        body {
            background-color: var(--bg-body);
            color: var(--color-black);
            min-height: 100vh;
            display: flex; align-items: center; justify-content: center;
            padding: 16px;
        }
        .error-wrap { text-align: center; max-width: 520px; }
        .error-code {
            font-family: 'Archivo Black', sans-serif;
            font-size: clamp(96px, 22vw, 180px);
            line-height: 1;
            -webkit-text-stroke: 3px var(--color-black);
            color: transparent;
        }
        .error-msg {
            font-size: 18px; font-weight: 700; margin: 16px 0 28px; text-transform: uppercase;
        }
        .btn-brutal {
            display: inline-flex; align-items: center; gap: 8px;
            background: var(--accent);
            border: var(--border-thick);
            box-shadow: var(--shadow-solid);
            padding: 14px 28px;
            font-family: 'Archivo Black', sans-serif;
            text-transform: uppercase;
            font-size: 15px;
            color: var(--color-black);
            text-decoration: none;
            transition: all 0.12s ease;
        }
        .btn-brutal:active { transform: translate(3px,3px); box-shadow: var(--shadow-hover); }
    </style>
</head>
<body>
    <div class="error-wrap">
        <i class="fas fa-exclamation-triangle" style="font-size:56px;color:var(--color-black);margin-bottom:10px"></i>
        <div class="error-code"><%= code %></div>
        <p class="error-msg"><%= message %></p>
        <a href="/" class="btn-brutal"><i class="fas fa-arrow-left"></i> Kembali</a>
    </div>
</body>
</html>
