<% content = `
<div class="space-y">
    <div style="background:var(--color-black);color:var(--bg-body);border:var(--border-thick);box-shadow:var(--shadow-solid);padding:26px">
        <h3 style="font-family:'Archivo Black',sans-serif;text-transform:uppercase;font-size:22px;color:var(--accent)">
            <i class="fas fa-hand-peace"></i> Selamat Datang, ${user.username}!
        </h3>
        <p class="mb-8" style="margin-top:8px;color:#c9c6ba">Kelola bot WhatsApp kamu disini</p>
    </div>

    <div class="grid-stats">
        <div class="card-brutal stat-card flex-bt">
            <div>
                <p class="stat-label">Bot Saya</p>
                <p class="stat-value" style="color:#118ab2">${myBots.length}</p>
            </div>
            <div class="stat-icon" style="background:#8ecae6"><i class="fas fa-robot"></i></div>
        </div>
        <div class="card-brutal stat-card flex-bt">
            <div>
                <p class="stat-label">Bot Tersedia</p>
                <p class="stat-value" style="color:#2a9d8f">${availableBots}</p>
            </div>
            <div class="stat-icon" style="background:#7bf1a8"><i class="fas fa-box-open"></i></div>
        </div>
        <div class="card-brutal stat-card flex-bt">
            <div>
                <p class="stat-label">Quota</p>
                <p class="stat-value" style="color:#b388eb">${botQuota}</p>
            </div>
            <div class="stat-icon" style="background:#b388eb"><i class="fas fa-layer-group"></i></div>
        </div>
    </div>

    <div class="card-brutal">
        <h3 class="card-title"><i class="fas fa-robot"></i> Bot Saya</h3>
        ${myBots.length === 0 ? `
            <div style="text-align:center;padding:34px 0">
                <i class="fas fa-robot" style="font-size:40px;color:#b9b4a6"></i>
                <p class="mt-16">Kamu belum punya bot</p>
                <p class="muted">Assign bot tersedia dibawah</p>
            </div>
        ` : `
            <div class="space-y">
                ${myBots.map(bot => `
                    <div style="border:var(--border-med);background:var(--bg-body);box-shadow:var(--shadow-sm);padding:14px" class="flex-bt">
                        <div>
                            <p style="font-family:'Archivo Black',sans-serif;text-transform:uppercase"><i class="fas fa-robot"></i> ${bot.folder}</p>
                            <span class="badge ${bot.connected ? 'badge-green' : 'badge-gray'}" style="margin-top:6px">
                                ${bot.connected ? 'Connected' : 'Stopped'}
                            </span>
                        </div>
                        <div class="row">
                            ${!bot.connected ? `
                                <a href="/api/user/bots/${bot.id}/connect?redirect=/user/dashboard" class="btn-brutal btn-brutal-sm btn-green"><i class="fas fa-plug"></i> Connect</a>
                            ` : `
                                <a href="/api/user/bots/${bot.id}/disconnect?redirect=/user/dashboard" class="btn-brutal btn-brutal-sm btn-red"><i class="fas fa-unplug"></i> Disconnect</a>
                            `}
                            <a href="/api/user/bots/${bot.id}/release?redirect=/user/dashboard" class="btn-brutal btn-brutal-sm btn-yellow" onclick="event.preventDefault(); confirmUserRelease(${bot.id}, '${bot.folder}')" title="Release bot"><i class="fas fa-times"></i></a>
                            <button onclick="confirmUserLogout(${bot.id}, '${bot.folder}')" class="btn-brutal btn-brutal-sm btn-dark" title="Logout dari WhatsApp"><i class="fas fa-sign-out-alt"></i></button>
                            <button onclick="showBotLog(${bot.id}, '${bot.folder}')" class="btn-brutal btn-brutal-sm btn-blue"><i class="fas fa-terminal"></i> Log</button>
                        </div>
                    </div>
                `).join('')}
            </div>
        `}
    </div>

    <div class="card-brutal">
        <h3 class="card-title"><i class="fas fa-plus-circle"></i> Assign Bot Baru</h3>
        ${botQuota <= 0 ? `
            <div style="text-align:center;padding:26px 0;border:var(--border-med);border-style:dashed;background:#fff3cd">
                <i class="fas fa-exclamation-triangle" style="font-size:32px;color:#b8860b"></i>
                <p class="mt-12" style="font-weight:700">Quota habis!</p>
                <p class="muted">Hubungi admin untuk menambah quota bot kamu.</p>
            </div>
        ` : availableBots > 0 ? `
            <div class="grid-bots" style="grid-template-columns:repeat(auto-fill,minmax(150px,1fr))">
                ${availableBotList.map(b => `
                    <a href="/api/user/bots/assign?bot_id=${b.id}&redirect=/user/dashboard"
                       class="bot-mini" style="transition:all 0.12s ease" title="Assign ${b.folder}">
                        <i class="fas fa-robot" style="font-size:22px;color:#b9b4a6"></i>
                        <p style="font-family:'Archivo Black',sans-serif;font-size:13px;margin-top:8px">${b.folder}</p>
                    </a>
                `).join('')}
            </div>
        ` : '<p class="muted">Tidak ada bot tersedia saat ini</p>'}
    </div>

    <div class="card-brutal">
        <div class="flex-bt mb-16">
            <h3 class="card-title" style="margin-bottom:0"><i class="fas fa-terminal"></i> Log Terminal: <span id="user-log-bot-name" style="color:#118ab2">-</span></h3>
            <div class="row">
                <button onclick="copyUserLog()" class="btn-brutal btn-brutal-sm btn-blue"><i class="fas fa-copy"></i> Copy</button>
                <button onclick="clearUserLog()" class="btn-brutal btn-brutal-sm btn-dark"><i class="fas fa-broom"></i> Bersihkan</button>
            </div>
        </div>
        <div id="user-log-viewer" class="logbox" style="height:300px;user-select:text">
            <p class="log-info">Klik tombol Log pada bot untuk melihat log...</p>
        </div>
    </div>
</div>
` %>

<%- include('../layouts/main', { title: 'Dashboard', content: content }) %>

<script>
    let userCurrentBot = null
    let userLogTimer = null

    async function showBotLog(id, folder) {
        userCurrentBot = { id, folder }
        document.getElementById('user-log-bot-name').textContent = folder
        const viewer = document.getElementById('user-log-viewer')
        try {
            const res = await fetch(`/api/user/bots/${id}/logs`)
            const data = await res.json()
            if (data.success) {
                const rows = data.logs.slice(-100).map(l =>
                    '<div class="' + (l.level === 'error' ? 'log-error' : l.level === 'warn' ? 'log-warn' : 'log-info') + '">[' + new Date(l.timestamp).toLocaleTimeString('id-ID') + '] ' + l.message + '</div>'
                ).join('')
                viewer.innerHTML = rows || '<p class="log-info">Belum ada log</p>'
                viewer.scrollTop = viewer.scrollHeight
            }
        } catch (e) {}
        if (userLogTimer) clearInterval(userLogTimer)
        userLogTimer = setInterval(() => { if (userCurrentBot) showBotLog(userCurrentBot.id, userCurrentBot.folder) }, 10000)
    }

    function copyUserLog() {
        const viewer = document.getElementById('user-log-viewer')
        const text = viewer.innerText || viewer.textContent
        const done = () => showToast('Log berhasil di-copy!', 'success')
        if (navigator.clipboard?.writeText) {
            navigator.clipboard.writeText(text).then(done).catch(() => fallbackCopy(text, done))
        } else {
            fallbackCopy(text, done)
        }
    }

    function fallbackCopy(text, done) {
        const ta = document.createElement('textarea')
        ta.value = text
        ta.style.position = 'fixed'
        ta.style.opacity = '0'
        document.body.appendChild(ta)
        ta.select()
        try { document.execCommand('copy') } catch (e) {}
        document.body.removeChild(ta)
        done && done()
    }

    function clearUserLog() {
        if (userLogTimer) clearInterval(userLogTimer)
        userCurrentBot = null
        document.getElementById('user-log-bot-name').textContent = '-'
        document.getElementById('user-log-viewer').innerHTML = '<p class="log-info">Klik tombol Log pada bot untuk melihat log...</p>'
    }

    setInterval(() => { window.location.reload() }, 15000)

    function confirmUserLogout(id, folder) {
        brutalConfirm({
            title: 'Logout Bot',
            message: `Yakin ingin LOGOUT ${folder}? Bot akan dikeluarkan dari WhatsApp dan kamu harus pairing ulang jika ingin memakainya lagi.`,
            confirmText: 'Logout',
            onConfirm: () => { window.location.href = `/api/user/bots/${id}/logout?redirect=/user/dashboard` }
        })
    }

    function confirmUserRelease(id, folder) {
        brutalConfirm({
            title: 'Release Bot',
            message: `Yakin ingin melepas ${folder}? Quota kamu akan berkurang 1 dan bot tidak bisa dipakai lagi sampai admin menambah quota.`,
            confirmText: 'Release',
            onConfirm: () => { window.location.href = `/api/user/bots/${id}/release?redirect=/user/dashboard` }
        })
    }
</script>
