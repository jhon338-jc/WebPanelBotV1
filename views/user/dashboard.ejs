<% content = `
<div class="space-y-6">
    <div class="bg-gradient-to-r from-blue-500 to-purple-600 rounded-xl p-6 text-white">
        <h3 class="text-2xl font-bold">Selamat Datang, ${user.username}! 👋</h3>
        <p class="mt-2 opacity-90">Kelola bot WhatsApp kamu disini</p>
    </div>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="card bg-white rounded-xl p-6 shadow-sm">
            <p class="text-sm text-gray-500">Bot Saya</p>
            <p class="text-3xl font-bold text-blue-600">${myBots.length}</p>
        </div>
        <div class="card bg-white rounded-xl p-6 shadow-sm">
            <p class="text-sm text-gray-500">Bot Tersedia</p>
            <p class="text-3xl font-bold text-green-600">${availableBots}</p>
        </div>
        <div class="card bg-white rounded-xl p-6 shadow-sm">
            <p class="text-sm text-gray-500">Quota</p>
            <p class="text-3xl font-bold text-purple-600">${botQuota}</p>
        </div>
    </div>
    
    <div class="card bg-white rounded-xl p-6 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">
            <i class="fas fa-robot mr-2 text-blue-600"></i> Bot Saya
        </h3>
        ${myBots.length === 0 ? `
            <div class="text-center py-8">
                <i class="fas fa-robot text-4xl text-gray-300 mb-3"></i>
                <p class="text-gray-500">Kamu belum punya bot</p>
                <p class="text-sm text-gray-400">Assign bot tersedia dibawah</p>
            </div>
        ` : `
            <div class="space-y-3">
                ${myBots.map(bot => `
                    <div class="flex items-center justify-between p-4 bg-gray-50 rounded-lg">
                        <div>
                            <p class="font-semibold text-gray-800">${bot.folder}</p>
                            <span class="text-xs px-2 py-1 rounded-full ${bot.connected ? 'bg-green-100 text-green-600' : 'bg-gray-100 text-gray-600'}">
                                ${bot.connected ? 'Connected' : 'Stopped'}
                            </span>
                        </div>
                        <div class="flex space-x-2">
                            ${!bot.connected ? `
                                <a href="/api/user/bots/${bot.id}/connect?redirect=/user/dashboard" class="px-3 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 text-sm">
                                    <i class="fas fa-plug mr-1"></i> Connect
                                </a>
                            ` : `
                                <a href="/api/user/bots/${bot.id}/disconnect?redirect=/user/dashboard" class="px-3 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 text-sm">
                                    <i class="fas fa-unplug mr-1"></i> Disconnect
                                </a>
                            `}
                            <a href="/api/user/bots/${bot.id}/release?redirect=/user/dashboard" class="px-3 py-2 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700 text-sm">
                                <i class="fas fa-times"></i>
                            </a>
                            <button onclick="confirmUserLogout(${bot.id}, '${bot.folder}')" class="px-3 py-2 bg-gray-800 text-white rounded-lg hover:bg-red-700 text-sm">
                                <i class="fas fa-sign-out-alt"></i>
                            </button>
                            <a href="javascript:void(0)" onclick="showBotLog(${bot.id}, '${bot.folder}')" class="px-3 py-2 bg-gray-700 text-white rounded-lg hover:bg-gray-800 text-sm">
                                <i class="fas fa-terminal mr-1"></i> Log
                            </a>
                        </div>
                    </div>
                `).join('')}
            </div>
        `}
    </div>

    <div class="card bg-white rounded-xl p-6 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-800 mb-4">
            <i class="fas fa-plus-circle mr-2 text-green-600"></i> Assign Bot Baru
        </h3>
        <div class="grid grid-cols-2 md:grid-cols-5 gap-3">
            ${availableBots > 0 ? `
                ${Array.from({ length: 10 }, (_, i) => {
                    const botNum = i + 1
                    const isAssigned = myBots.some(b => b.folder === 'Bot' + botNum)
                    if (isAssigned) return ''
                    return `
                        <a href="/api/user/bots/assign?bot_id=${botNum}&redirect=/user/dashboard" 
                           class="p-4 bg-gray-50 rounded-lg hover:bg-blue-50 hover:border-blue-300 border-2 border-transparent transition text-center">
                            <i class="fas fa-robot text-2xl text-gray-400 mb-2"></i>
                            <p class="text-sm font-semibold text-gray-700">Bot${botNum}</p>
                        </a>
                    `
                }).join('')}
            ` : '<p class="text-gray-500">Tidak ada bot tersedia</p>'}
        </div>
    </div>

    <div class="card bg-white rounded-xl p-6 shadow-sm">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-800">
                <i class="fas fa-terminal mr-2 text-blue-600"></i> Log Bot: <span id="user-log-bot-name">-</span>
            </h3>
            <button onclick="clearUserLog()" class="px-3 py-1 text-sm bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300">Bersihkan</button>
        </div>
        <div id="user-log-viewer" class="log-container bg-gray-900 text-gray-100 rounded-lg p-4 h-72 overflow-y-auto">
            <p class="log-info">Klik tombol Log pada bot untuk melihat log...</p>
        </div>
    </div>
</div>
` %>

<%- include('../layouts/main', { title: 'Dashboard', content: content }) %>

<script>
    let userCurrentBot = null
    let userLogTimer = null

    async function showBotLog(id, folder) {
        userCurrentBot = { id, folder }
        document.getElementById('user-log-bot-name').textContent = folder
        const viewer = document.getElementById('user-log-viewer')
        try {
            const res = await fetch(`/api/user/bots/${id}/logs`)
            const data = await res.json()
            if (data.success) {
                viewer.innerHTML = data.logs.map(l =>
                    `<div class="${l.level === 'error' ? 'log-error' : l.level === 'warn' ? 'log-warn' : 'log-info'}">[${new Date(l.timestamp).toLocaleTimeString('id-ID')}] ${l.message}</div>`
                ).join('') || '<p class="log-info">Belum ada log</p>'
                viewer.scrollTop = viewer.scrollHeight
            }
        } catch (e) {}
        if (userLogTimer) clearInterval(userLogTimer)
        userLogTimer = setInterval(() => { if (userCurrentBot) showBotLog(userCurrentBot.id, userCurrentBot.folder) }, 10000)
    }

    function clearUserLog() {
        if (userLogTimer) clearInterval(userLogTimer)
        userCurrentBot = null
        document.getElementById('user-log-bot-name').textContent = '-'
        document.getElementById('user-log-viewer').innerHTML = '<p class="log-info">Klik tombol Log pada bot untuk melihat log...</p>'
    }

    setInterval(() => { window.location.reload() }, 15000)

    // Konfirmasi sebelum logout (hapus auth) bot milik user
    function confirmUserLogout(id, folder) {
        if (confirm(`Yakin ingin LOGOUT ${folder}?\n\nBot akan dikeluarkan dari WhatsApp dan kamu harus pairing ulang jika ingin memakainya lagi.`)) {
            window.location.href = `/api/user/bots/${id}/logout?redirect=/user/dashboard`
        }
    }
</script>
